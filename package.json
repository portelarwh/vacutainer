{
  "name": "vacutainer-plataforma",
  "version": "1.8.51",
  "private": true,
  "description": "Aplicativo único e editável em Plataforma.html. Testes e documentação não são dependências de execução.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/check-setup.mjs && node scripts/verificar.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "atualizar:metadados": "node scripts/verificar.mjs --atualizar",
    "dev": "node scripts/servir.mjs",
    "test": "node testes/tudo.js",
    "test:unit": "node scripts/testar-plataforma.mjs --unit",
    "test:plataforma": "node scripts/testar-plataforma.mjs",
    "test:reprodutibilidade": "node scripts/reprodutibilidade.mjs",
    "test:celular": "node testes/celular/meu-turno.cjs",
    "varredura:visual": "node scripts/varredura-visual.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:regras": "node verify.mjs",
    "celular:site": "node scripts/celular-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "playwright": "1.63.0"
  }
}
