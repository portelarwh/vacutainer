{
  "name": "vacutainer-plataforma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare:engines": "npm --prefix .. run build && node scripts/package-engines.mjs",
    "build": "npm run prepare:engines && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "test": "node --import tsx --test tests/*.test.*",
    "test:browser": "node tests/browser.cjs",
    "test:pasta": "node tests/pasta.cjs",
    "test:abas": "node tests/abas.cjs",
    "test:contrato": "node tests/contrato.cjs",
    "test:login": "VAC_PLATAFORMA=1 node ../testes/tlogin.js",
    "test:permissoes": "VAC_PLATAFORMA=1 node ../testes/tpermissoes.js",
    "test:all": "npm test && npm run test:contrato && npm run test:abas && npm run test:pasta && npm run test:integracao && npm run test:paridade-permissoes && npm run test:conta && npm run test:login && npm run test:permissoes && npm run test:browser",
    "test:integracao": "node tests/integracao.cjs",
    "test:conta": "node tests/conta.cjs",
    "test:paridade-permissoes": "node tests/permissoes-paridade.cjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.3.0",
    "tsx": "4.19.4",
    "playwright": "1.62.1"
  }
}
